{
  "name": "loccloak",
  "version": "2.1.0",
  "description": "隐影斗篷 (LocCloak) - Android 虚拟定位控制工具：内置官方 ADB、免选模拟应用、防检测、坐标系统一换算、高德在线选点、GPX 轨迹回放",
  "type": "commonjs",
  "bin": {
    "loccloak": "bin/loccloak.js",
    "locctl": "bin/loccloak.js"
  },
  "main": "src/cli.js",
  "scripts": {
    "build:exe": "node scripts/build-exe.js",
    "ui": "node bin/locctl.js ui",
    "doctor": "node bin/locctl.js doctor",
    "loc": "node bin/locctl.js",
    "demo": "node bin/locctl.js hold --at 杭州西湖",
    "gpx": "node scripts/make-demo-gpx.js",
    "test": "node scripts/e2e.js"
  },
  "keywords": [
    "adb",
    "android",
    "mock-location",
    "virtual-location",
    "gps",
    "gpx",
    "gcj02",
    "bd09",
    "wgs84",
    "cli"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "author": "gitstq",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gitstq/LocCloak.git"
  },
  "bugs": {
    "url": "https://github.com/gitstq/LocCloak/issues"
  },
  "homepage": "https://github.com/gitstq/LocCloak#readme",
  "files": [
    "bin/",
    "src/",
    "routes/",
    "README.md",
    "LICENSE"
  ]
}